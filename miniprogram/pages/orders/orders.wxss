.tabs {
  display: flex;
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #909399;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.tab-active {
  background: #409eff;
  color: #fff;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  color: #c0c4cc;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.row-item:last-child {
  border-bottom: none;
}

.r-info {
  flex: 1;
  min-width: 0;
}

.r-title {
  font-size: 28rpx;
  color: #303133;
}

.r-price {
  color: #f56c6c;
  font-weight: 600;
}

.r-sub {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
}

.r-btns {
  display: flex;
  gap: 12rpx;
}

.r-btn {
  margin: 0;
}

.tag-warn {
  background: #fdf6ec;
  color: #e6a23c;
}

.tag-success {
  background: #f0f9eb;
  color: #67c23a;
}

.tag-plain {
  background: #f4f4f5;
  color: #909399;
}
