.book-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.book-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #303133;
  flex: 1;
}

.cover {
  width: 200rpx;
  height: 280rpx;
  object-fit: contain;
  border-radius: 8rpx;
  background: #f0f0f0;
  margin-bottom: 16rpx;
}

.tag-status {
  background: #f0f9eb;
  color: #67c23a;
}

.tag-sold {
  background: #fef0f0;
  color: #f56c6c;
}

.tag-off {
  background: #f4f4f5;
  color: #909399;
}

.price-line {
  font-size: 30rpx;
  color: #606266;
  padding: 8rpx 0;
}

.price {
  color: #f56c6c;
  font-size: 44rpx;
  font-weight: 700;
}

.book-meta-line {
  font-size: 28rpx;
  color: #606266;
  padding: 10rpx 0;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  flex-direction: column;
}

.action-btn {
  width: 100%;
}

.action-btn.mini {
  width: auto;
  margin: 0;
  flex: 1;
  border-radius: 12rpx;
}

.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #606266;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.row-btns {
  display: flex;
  gap: 16rpx;
  width: 60%;
}

.own-tip,
.loading-tip {
  text-align: center;
  color: #909399;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.btn-warning {
  background: #e6a23c;
  color: #fff;
}

.not-found {
  font-size: 30rpx;
  color: #303133;
  text-align: center;
}

.nf-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.nf-sub {
  font-size: 24rpx;
  color: #909399;
  margin: 4rpx 0 20rpx;
}

.input {
  background: #f5f7fa;
}

.count-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.count-label {
  font-size: 26rpx;
  color: #606266;
  white-space: nowrap;
}

.count-input {
  flex: 1;
  margin-bottom: 0;
}