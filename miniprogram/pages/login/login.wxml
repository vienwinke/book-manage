<view class="login-page">
  <view class="logo">📚</view>
  <view class="app-name">扫码识书 · 二手书交易</view>
  <view class="app-desc">扫描 ISBN 自动匹配本地书库</view>

  <input class="input name-input" placeholder="账号（如 admin / stu01）" value="{{username}}" bindinput="onUsernameInput"/>
  <input class="input name-input" placeholder="密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput"/>

  <button class="btn btn-primary login-btn" bindtap="doLogin" disabled="{{loading}}">{{loading ? '登录中...' : '登录'}}</button>
  <view class="register-link" bindtap="goRegister">没有账号？立即注册</view>
  <view class="tip">演示账号：admin / 123456、stu01 / 123456</view>
</view>
