.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.avatar {
  font-size: 72rpx;
}

.profile-info {
  flex: 1;
}

.profile-role {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.profile-desc {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
}

.logout-btn {
  font-size: 26rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-card .card-title {
  margin-bottom: 0;
}

.link-arrow {
  font-size: 44rpx;
  color: #c0c4cc;
}

.empty {
  text-align: center;
  color: #c0c4cc;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.row-item:last-child {
  border-bottom: none;
}

.r-info {
  flex: 1;
  min-width: 0;
}

.r-title {
  font-size: 28rpx;
  color: #303133;
}

.r-price {
  color: #f56c6c;
  font-weight: 600;
}

.r-sub {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
}

.r-btns {
  display: flex;
  gap: 12rpx;
}

.r-btn {
  margin: 0;
}

.tag-warn {
  background: #fdf6ec;
  color: #e6a23c;
}

.tag-success {
  background: #f0f9eb;
  color: #67c23a;
}

.tag-danger {
  background: #fef0f0;
  color: #f56c6c;
}

.tag-plain {
  background: #f4f4f5;
  color: #909399;
}

.btn-warning {
  background: #e6a23c;
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.btn-warning::after {
  border: none;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #409eff;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
}

.bk-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 26rpx;
}

.bk-row:last-child {
  border-bottom: none;
}

.bk-count {
  color: #909399;
}